{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntigravityReviewResult",
  "type": "object",
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "explanation", "recommendation", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "title": { "type": "string" },
          "explanation": { "type": "string" },
          "recommendation": { "type": "string" },
          "confidence": { "enum": ["low", "medium", "high"] }
        }
      }
    }
  }
}
